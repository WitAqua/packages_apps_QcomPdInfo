<!-- Label on the left at 0.4 of the width, value on the right at 0.6. The
     margins are small on purpose: a table of readings is read as a block. -->
<TableRow xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_column="0"
        android:layout_weight="0.4"
        android:paddingStart="@dimen/row_padding_horizontal"
        android:paddingTop="@dimen/row_padding_vertical"
        android:paddingEnd="@dimen/row_padding_horizontal"
        android:paddingBottom="@dimen/row_padding_vertical"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/value"
        android:layout_width="0dp"
        android:layout_column="1"
        android:layout_weight="0.6"
        android:paddingTop="@dimen/row_padding_vertical"
        android:paddingEnd="@dimen/row_padding_horizontal"
        android:paddingBottom="@dimen/row_padding_vertical"
        android:textColor="?android:attr/textColorPrimary"
        android:textIsSelectable="true"
        android:textSize="14sp" />
</TableRow>
