<!-- The build that installs on somebody else's ROM. Ordinary signature, no
     shared user id: nothing there labelled the nodes for this app, so the
     reads go through a root shell instead. A distinct application id so it can
     sit alongside the built-in one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.witaqua.qcom.pd_info.root"
    android:versionCode="1"
    android:versionName="1.0">

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PdInfo">
        <activity
            android:name="org.witaqua.qcom.pd_info.ui.PdInfoActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
